<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Merchant Portal v2.0</title>
    <style>
        :root {
            --bg-color: #0f1115;
            --card-bg: #161920;
            --input-bg: #1e222b;
            --accent-color: #3b82f6;
            --accent-hover: #2563eb;
            --text-main: #f3f4f6;
            --text-muted: #9ca3af;
            --border-color: #2d3139;
            --success-color: #10b981;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background-color: var(--bg-color);
            color: var(--text-main);
            margin: 0;
            padding: 0;
            display: flex;
            flex-direction: column;
            align-items: center;
            min-height: 100vh;
        }

        /* Top Navigation Tabs mimicking your spreadsheet structure */
        .tab-navigation {
            width: 100%;
            background-color: var(--card-bg);
            border-bottom: 1px solid var(--border-color);
            display: flex;
            overflow-x: auto;
            padding: 0 20px;
            box-sizing: border-box;
        }

        .tab {
            padding: 16px 20px;
            font-size: 14px;
            font-weight: 500;
            color: var(--text-muted);
            cursor: pointer;
            border-bottom: 3px solid transparent;
            white-space: nowrap;
            transition: all 0.2s ease;
        }

        .tab.active {
            color: var(--accent-color);
            border-bottom-color: var(--accent-color);
            background-color: rgba(59, 130, 246, 0.05);
        }

        .tab.disabled {
            opacity: 0.4;
            cursor: not-allowed;
        }

        .container {
            width: 100%;
            max-width: 680px;
            padding: 40px 20px;
            box-sizing: border-box;
        }

        header {
            margin-bottom: 32px;
            text-align: center;
        }

        h1 {
            font-size: 26px;
            font-weight: 600;
            margin: 0 0 8px 0;
            letter-spacing: -0.02em;
        }

        header p {
            color: var(--text-muted);
            margin: 0;
            font-size: 14px;
        }

        .form-card {
            background-color: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 16px;
            padding: 36px;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.3);
        }

        .form-group {
            margin-bottom: 24px;
        }

        label {
            display: block;
            font-size: 12px;
            font-weight: 600;
            margin-bottom: 8px;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        input[type="text"], select, textarea {
            width: 100%;
            padding: 14px;
            background-color: var(--input-bg);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            color: var(--text-main);
            font-size: 15px;
            box-sizing: border-box;
            transition: all 0.2s ease;
        }

        input:focus, select:focus, textarea:focus {
            outline: none;
            border-color: var(--accent-color);
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.15);
        }

        textarea {
            resize: vertical;
            min-height: 120px;
            font-family: inherit;
        }

        .grid-2 {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
        }

        @media (max-width: 480px) {
            .grid-2 {
                grid-template-columns: 1fr;
                gap: 0;
            }
        }

        button {
            width: 100%;
            padding: 16px;
            background-color: var(--accent-color);
            border: none;
            border-radius: 8px;
            color: white;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: background-color 0.2s ease;
            margin-top: 10px;
        }

        button:hover {
            background-color: var(--accent-hover);
        }

        button:disabled {
            background-color: var(--border-color);
            color: var(--text-muted);
            cursor: not-allowed;
        }

        #statusMessage {
            margin-top: 20px;
            font-size: 14px;
            text-align: center;
            font-weight: 500;
            padding: 12px;
            border-radius: 8px;
            display: none;
        }
    </style>
</head>
<body>

<!-- Navigation Bar mapping out your exact structure -->
<nav class="tab-navigation">
    <div class="tab active">Q4 Call Follow Up</div>
    <div class="tab disabled">Photo & Description Tracker (Locked)</div>
    <div class="tab disabled">Pending Photos (Locked)</div>
    <div class="tab disabled">Photoshoot Tracker (Locked)</div>
    <div class="tab disabled">Case Tracker (Locked)</div>
</nav>

<div class="container">
    <header>
        <h1>Q4 Call Follow Up</h1>
        <p>Log client interactions cleanly and accurately</p>
    </header>

    <div class="form-card">
        <form id="callTrackerForm">
            <!-- Store Name -->
            <div class="form-group">
                <label for="storeName">Store Name</label>
                <input type="text" id="storeName" name="storeName" placeholder="Enter store or merchant name" required>
            </div>

            <div class="grid-2">
                <!-- Call Goals Dropdown -->
                <div class="form-group">
                    <label for="callGoal">Call Goal</label>
                    <select id="callGoal" name="callGoal" required>
                        <option value="" disabled selected>Select a goal...</option>
                        <option value="Decision Maker Call">Decision Maker Call</option>
                        <option value="Gate keeper call">Gate keeper call</option>
                        <option value="Google Meet Meeting">Google Meet Meeting</option>
                    </select>
                </div>

                <!-- Call Results Dropdown -->
                <div class="form-group">
                    <label for="callResult">Call Result</label>
                    <select id="callResult" name="callResult" required>
                        <option value="" disabled selected>Select a result...</option>
                        <option value="Completed">Completed</option>
                        <option value="Appointment set">Appointment set</option>
                        <option value="Pitching">Pitching</option>
                        <option value="No answer">No answer</option>
                        <option value="Left VM">Left VM</option>
                        <option value="Hung up">Hung up</option>
                        <option value="Requested callback">Requested callback</option>
                        <option value="DM Identified">DM Identified</option>
                        <option value="Incorrect number">Incorrect number</option>
                    </select>
                </div>
            </div>

            <!-- Call Notes -->
            <div class="form-group">
                <label for="callNotes">Call Notes</label>
                <textarea id="callNotes" name="callNotes" placeholder="Type detailed log details here..."></textarea>
            </div>

            <button type="submit" id="submitBtn">Log Call Entry</button>
        </form>
        <div id="statusMessage"></div>
    </div>
</div>

<script>
    // Link your active DoorDash Apps Script Web App URL here
    const WEB_APP_URL = "https://script.google.com/a/macros/ext.doordash.com/s/AKfycbwh7GddixjGsa8F1WHE45UZ7JmR4wZBAHrEcks8XUan-2PnwI0G-pnbQ5vX62OKtggAJQ/exec";

    document.getElementById('callTrackerForm').addEventListener('submit', function(e) {
        e.preventDefault();
        
        const btn = document.getElementById('submitBtn');
        const status = document.getElementById('statusMessage');
        
        btn.disabled = true;
        btn.textContent = "Logging to Master Sheet...";
        status.style.display = "none";

        const formData = new FormData(this);
        const data = Object.fromEntries(formData.entries());

        fetch(WEB_APP_URL, {
            method: 'POST',
            mode: 'no-cors',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        })
        .then(() => {
            status.style.display = "block";
            status.style.backgroundColor = "rgba(16, 185, 129, 0.1)";
            status.style.color = "#10b981";
            status.style.border = "1px solid rgba(16, 185, 129, 0.2)";
            status.textContent = "✓ Call logged successfully in database!";
            document.getElementById('callTrackerForm').reset();
        })
        .catch(err => {
            status.style.display = "block";
            status.style.backgroundColor = "rgba(239, 68, 68, 0.1)";
            status.style.color = "#ef4444";
            status.style.border = "1px solid rgba(239, 68, 68, 0.2)";
            status.textContent = "✕ Network error. Please check backend link.";
            console.error(err);
        })
        .finally(() => {
            btn.disabled = false;
            btn.textContent = "Log Call Entry";
        });
    });
</script>

</body>
</html>
